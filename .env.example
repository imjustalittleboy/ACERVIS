# ACERVIS PROTOCOL — Environment Variables v3.1.0
# Copy to .env and fill in values before deploying to Vercel

# ── Neon Serverless Postgres ──
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/acervis?sslmode=require

# ── Cryptographic Secrets ──
# HMAC Pepper (32-char random string) — used in NCN hash synthesis
PROTOCOL_PEPPER=your-32-char-random-pepper-here
# Super Admin governance secret — sent as x-super-admin-secret header
SUPER_ADMIN_SECRET=your-super-admin-secret-here

# ── Blockchain (Polygon Amoy Testnet) ──
ALCHEMY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-api-key
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
INSTITUTION_PRIVATE_KEY=your-institution-wallet-private-key
# For Hardhat deployment:
# PRIVATE_KEY=your-deployer-wallet-private-key

# ── Optional: Polygonscan for contract verification ──
# POLYGONSCAN_API_KEY=your-polygonscan-api-key

# ── Deployment ──
# VERCEL_URL=your-project.vercel.app
