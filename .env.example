# ACERVIS PROTOCOL — Environment Variables
# Copy this file to .env and fill in your values

# Neon Serverless Postgres
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/acervis?sslmode=require

# HMAC Global Pepper (use a 32-char random string)
PROTOCOL_PEPPER=your-32-char-random-pepper-here

# Super Admin governance secret (used in x-super-admin-secret header)
SUPER_ADMIN_SECRET=your-super-admin-secret-here

# Alchemy RPC URL for Polygon Amoy
ALCHEMY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-api-key

# Deployed AcervisRegistry contract address on Polygon Amoy
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
